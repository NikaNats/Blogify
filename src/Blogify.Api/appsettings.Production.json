{
  "Database": {
    "MigrateOnStartup": false
  },
  "Authentication": {
    "RequireHttpsMetadata": true
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "RateLimiting": {
    "Enabled": true,
    "AuthPermitLimit": 10,
    "AuthWindowSeconds": 60,
    "ApiPermitLimit": 100,
    "ApiWindowSeconds": 60
  }
}
